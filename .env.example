# Copiar a backend/.env y completar. NUNCA commitear .env (tiene secretos).
# Las variables sin valor quedan vacias: el servidor falla con un mensaje claro
# en vez de arrancar a medias.

# --- Servidor ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origen adicional permitido por CORS. En desarrollo Vite ya esta en la lista.
# FRONTEND_URL=https://tu-frontend.vercel.app

# --- Autenticacion -----------------------------------------------------------
# Obligatorio cambiarlo en produccion
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# --- Base de datos (Postgres / Neon) -----------------------------------------
# Conexion que usa la APP (pooled)
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Conexion DIRECTA (sin pooler) para migraciones y seed
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

NEON_BRANCH=development

# Base de TEST, SIEMPRE distinta de la de la app
TEST_DATABASE_URL=postgresql://usuario:password@localhost:5432/compushop_test?sslmode=disable

# Opcionales
# PGPOOL_MAX=10
# PGSSL=require
# PG_SSL_NO_VERIFY=false

# --- Correo (opcional) -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Compushop <noreply@compushop.com>
CONTACT_TO=contacto@compushop.com

# --- Sembrado ----------------------------------------------------------------
# Proteccion para evitar seed en produccion
# SEED_FORCE=true
