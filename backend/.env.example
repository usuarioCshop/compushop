# Copiar a backend/.env y completar. NUNCA commitear .env (tiene secretos).
# Las variables sin valor quedan vacias: el servidor falla con un mensaje claro
# en vez de arrancar a medias.

# --- Servidor ---------------------------------------------------------------
PORT=4000

# Origen adicional permitido por CORS. En desarrollo Vite ya esta en la lista.
# FRONTEND_URL=https://tu-frontend.vercel.app

# --- Autenticacion ----------------------------------------------------------
# Obligatorio cambiarlo en produccion: el default del codigo es publico.
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# --- Base de datos (Postgres / Neon) ----------------------------------------
# Conexion que usa la APP. Tiene que ser el endpoint "pooled" de Neon, porque
# en serverless cada invocacion abre su propia conexion.
# Formato: postgresql://USUARIO:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_ZaOeB28RFUwo@ep-long-leaf-b6myr4fz-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Conexion DIRECTA (sin pooler). La usan `npm run migrate` y `npm run seed`,
# que necesitan una sesion larga. Si falta, esos scripts caen a DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_ZaOeB28RFUwo@ep-long-leaf-b6myr4fz.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# Base de TEST, SIEMPRE distinta de la de la app: los tests migran, truncan y
# vuelven a sembrar. Sin esta variable la suite se saltea, y en CI falla a
# proposito para que el verde no sea falso.
TEST_DATABASE_URL=

# Opcionales de conexion (dejar comentadas salvo que hagan falta).
# PGPOOL_MAX=1
# PGSSL=disable
# PG_SSL_NO_VERIFY=true

# --- Correo (opcional) ------------------------------------------------------
# Si SMTP_USER / SMTP_PASS estan vacios, los mensajes de contacto se guardan
# igual en la base pero no se envian: no es un error fatal.
# Estos valores se pueden pisar desde la tabla `settings` del panel de admin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Compushop <noreply@compushop.com>
CONTACT_TO=contacto@compushop.com

# --- Sembrado ---------------------------------------------------------------
# `npm run seed` se niega a correr con NODE_ENV=production salvo que pongas
# SEED_FORCE=true. Es una proteccion: no la desactives por comodidad.
# SEED_FORCE=true
